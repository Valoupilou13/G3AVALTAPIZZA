graph LR
    subgraph Acteurs
        V[Visiteur]
        C[Client]
        R[Restaurateur]
        M[Service Mail]
    end

    subgraph RestoWeb Lot 1
        UC1(S'inscrire)
        UC2(Se connecter / Déconnecter)
        UC3(Afficher la liste des produits)
        UC4(Passer une commande)
        UC5(Choisir le mode de repas & TVA)
        UC6(Payer par carte fictive)
        UC7(Accepter / Refuser commande)
        UC8(Indiquer commande prête)
        UC9(Notifier le client par mail)
        UC10(Indiquer commande retirée)
    end

    V --> UC1
    V -.-> C
    C --> UC2
    C --> UC3
    C --> UC4

    UC4 -. include .-> UC5
    UC4 -. include .-> UC6

    R --> UC2
    R --> UC7
    R --> UC8
    R --> UC10

    UC8 -. include .-> UC9
    UC9 --> M
